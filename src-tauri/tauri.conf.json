{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempus",
  "version": "0.1.0",
  "identifier": "app.tempus.timelapse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Tempus",
        "width": 480,
        "height": 640,
        "minWidth": 480,
        "minHeight": 640,
        "maxWidth": 480,
        "maxHeight": 640,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "backgroundThrottling": "disabled",
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Private screenshot timelapses",
    "longDescription": "Capture screen or camera screenshots into private local timelapse videos.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
